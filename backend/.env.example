CAT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
CAT_CORS_ORIGINS=["http://localhost","http://127.0.0.1"]

# Optional facts-only phrasing. Keep CAT_LLM_PROVIDER=none for template-only mode.
CAT_LLM_PROVIDER=none
CAT_GEMINI_API_KEY=
CAT_GEMINI_MODEL=gemini-3.8-live
CAT_OPENAI_API_KEY=
CAT_OPENAI_MODEL=gpt-4.1-mini
CAT_LLM_TIMEOUT_SECONDS=3
